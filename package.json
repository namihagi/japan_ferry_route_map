{
  "name": "japan-ferry-route-map",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm data:build && vite",
    "build": "pnpm data:build && vite build",
    "preview": "vite preview",
    "data:build": "node scripts/build-data.ts",
    "data:import-osm": "node scripts/import-osm.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:estimate": "uv run --project tools/sea-router sea-router"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/line-slice": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  }
}
